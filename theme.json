{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1180px"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"link": true,
			"palette": [
				{
					"color": "#f7f4ec",
					"name": "Paper",
					"slug": "paper"
				},
				{
					"color": "#ffffff",
					"name": "White",
					"slug": "white"
				},
				{
					"color": "#1e2930",
					"name": "Ink",
					"slug": "ink"
				},
				{
					"color": "#53616a",
					"name": "Slate",
					"slug": "slate"
				},
				{
					"color": "#9c3e2e",
					"name": "Terracotta",
					"slug": "terracotta"
				},
				{
					"color": "#6a281e",
					"name": "Terracotta dark",
					"slug": "terracotta-dark"
				},
				{
					"color": "#e2ddd2",
					"name": "Line",
					"slug": "line"
				},
				{
					"color": "#006f8b",
					"name": "Focus",
					"slug": "focus"
				}
			]
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"units": [
				"px",
				"rem",
				"vw",
				"vh",
				"%"
			],
			"spacingSizes": [
				{
					"name": "2XS",
					"size": "0.5rem",
					"slug": "10"
				},
				{
					"name": "XS",
					"size": "0.75rem",
					"slug": "20"
				},
				{
					"name": "S",
					"size": "1rem",
					"slug": "30"
				},
				{
					"name": "M",
					"size": "clamp(1.25rem, 2vw, 1.75rem)",
					"slug": "40"
				},
				{
					"name": "L",
					"size": "clamp(2rem, 4vw, 3.5rem)",
					"slug": "50"
				},
				{
					"name": "XL",
					"size": "clamp(3.5rem, 7vw, 6.5rem)",
					"slug": "60"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"dropCap": false,
			"fluid": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true,
			"writingMode": false,
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"name": "System Sans",
					"slug": "system-sans"
				},
				{
					"fontFamily": "Georgia, \"Times New Roman\", serif",
					"name": "System Serif",
					"slug": "system-serif"
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"name": "Medium",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"min": "1.125rem",
						"max": "1.35rem"
					},
					"name": "Lead",
					"size": "1.25rem",
					"slug": "lead"
				},
				{
					"fluid": {
						"min": "1.8rem",
						"max": "2.75rem"
					},
					"name": "Large",
					"size": "2.25rem",
					"slug": "large"
				},
				{
					"fluid": {
						"min": "2.5rem",
						"max": "5rem"
					},
					"name": "Display",
					"size": "4rem",
					"slug": "display"
				}
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"dimensions": {
			"minHeight": true
		},
		"position": {
			"sticky": true
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|paper",
			"text": "var:preset|color|ink"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|30",
			"padding": {
				"left": "var:preset|spacing|30",
				"right": "var:preset|spacing|30"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system-sans",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.65"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "0.2rem"
				},
				"color": {
					"background": "var:preset|color|terracotta",
					"text": "var:preset|color|white"
				},
				"spacing": {
					"padding": {
						"bottom": "0.75rem",
						"left": "1.1rem",
						"right": "1.1rem",
						"top": "0.75rem"
					}
				},
				"typography": {
					"fontSize": "0.95rem",
					"fontWeight": "700"
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|slate"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|system-serif",
					"fontWeight": "700",
					"lineHeight": "1.12"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|terracotta-dark"
				},
				"typography": {
					"textDecoration": "underline"
				}
			}
		},
		"blocks": {
			"core/button": {
				"typography": {
					"textTransform": "none"
				}
			},
			"core/image": {
				"border": {
					"radius": "0.25rem"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "0.95rem",
					"fontWeight": "650"
				}
			},
			"core/post-date": {
				"color": {
					"text": "var:preset|color|slate"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/post-excerpt": {
				"color": {
					"text": "var:preset|color|slate"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|system-serif",
					"fontWeight": "700",
					"lineHeight": "1.18"
				}
			},
			"core/pullquote": {
				"border": {
					"color": "var:preset|color|terracotta",
					"style": "solid",
					"width": "0 0 0 4px"
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|40"
					}
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-wide",
			"postTypes": [
				"page"
			],
			"title": "Page (Wide)"
		}
	],
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}

