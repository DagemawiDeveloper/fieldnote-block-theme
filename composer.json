{
	"name": "dagemawi-developer/fieldnote-quality-tools",
	"description": "Development-only PHP quality tooling for Fieldnote.",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "1.2.1",
		"wp-coding-standards/wpcs": "3.4.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs --standard=phpcs.xml.dist",
		"lint:fix": "phpcbf --standard=phpcs.xml.dist"
	}
}
