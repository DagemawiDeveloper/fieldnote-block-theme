{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Fieldnote editorial system",
		"description": "A one-click demonstration of the Fieldnote block theme and its optional editorial block plugin.",
		"author": "Dagemawi Alemayehu",
		"categories": ["Themes", "Blocks", "Publishing"]
	},
	"preferredVersions": {
		"php": "8.3",
		"wp": "7.1"
	},
	"features": {
		"networking": true
	},
	"landingPage": "/editorial-blocks/",
	"login": true,
	"steps": [
		{
			"step": "installTheme",
			"themeData": {
				"resource": "git:directory",
				"url": "https://github.com/DagemawiDeveloper/fieldnote-block-theme",
				"ref": "main",
				"refType": "branch",
				"path": "/"
			},
			"options": {
				"activate": true,
				"targetFolderName": "fieldnote"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/DagemawiDeveloper/fieldnote-block-theme",
				"ref": "main",
				"refType": "branch",
				"path": "plugins/fieldnote-editorial-blocks"
			},
			"options": {
				"activate": true,
				"targetFolderName": "fieldnote-editorial-blocks"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/fieldnote-demo-seed.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/DagemawiDeveloper/fieldnote-block-theme/main/demo/seed.php"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/fieldnote-demo-seed.php';"
		}
	]
}
