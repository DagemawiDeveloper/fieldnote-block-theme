{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Ink",
	"styles": {
		"color": {
			"background": "var:preset|color|ink",
			"text": "var:preset|color|mist"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var:preset|color|saffron",
					"text": "var:preset|color|ink"
				}
			},
			"heading": {
				"color": {"text": "var:preset|color|white"}
			},
			"link": {
				"color": {"text": "var:preset|color|sky"}
			}
		},
		"blocks": {
			"core/post-excerpt": {
				"color": {"text": "var:preset|color|mist"}
			},
			"core/post-date": {
				"color": {"text": "var:preset|color|sky"}
			}
		}
	}
}
