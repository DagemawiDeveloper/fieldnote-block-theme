{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"slug": "fieldnote-signal",
	"title": "Fieldnote Signal",
	"blockTypes": ["core/group", "core/columns"],
	"styles": {
		"color": {
			"background": "var:preset|color|clay",
			"text": "var:preset|color|white"
		},
		"spacing": {
			"padding": {
				"bottom": "var:preset|spacing|60",
				"left": "var:preset|spacing|60",
				"right": "var:preset|spacing|60",
				"top": "var:preset|spacing|60"
			}
		},
		"elements": {
			"heading": {
				"color": {"text": "var:preset|color|white"}
			},
			"link": {
				"color": {"text": "var:preset|color|white"}
			}
		},
		"blocks": {
			"core/button": {
				"color": {
					"background": "var:preset|color|ink",
					"text": "var:preset|color|white"
				}
			}
		}
	}
}
