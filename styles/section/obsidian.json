{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"slug": "fieldnote-obsidian",
	"title": "Fieldnote Obsidian",
	"blockTypes": ["core/group", "core/columns"],
	"styles": {
		"background": {
			"gradient": "var:preset|gradient|night-forest"
		},
		"color": {
			"text": "var:preset|color|mist"
		},
		"spacing": {
			"padding": {
				"bottom": "var:preset|spacing|60",
				"left": "var:preset|spacing|60",
				"right": "var:preset|spacing|60",
				"top": "var:preset|spacing|60"
			}
		},
		"elements": {
			"heading": {
				"color": {"text": "var:preset|color|white"}
			},
			"link": {
				"color": {"text": "var:preset|color|sky"}
			}
		},
		"blocks": {
			"core/button": {
				"color": {
					"background": "var:preset|color|saffron",
					"text": "var:preset|color|ink"
				}
			}
		}
	}
}
